fb_render() {
    [[ -f $FB_PY ]] || return
    # 保存状态供背景定时器每秒刷新使用
    echo "${1:-0}|${2:-}|${3:-0}|${4:-1}|${5:-}|${6:-}" > "$FB_STATE_FILE"
    python3 "$FB_PY" \
        --progress "${1:-0}" \
        --status   "${2:-}" \
        --count    "${3:-0}" \
        --total    "${4:-1}" \
        --from-ver "${5:-}" \
        --to-ver   "${6:-}" \
        --elapsed  "${7:-0}" \
        2>/dev/null
}

fb_render_error() {
    [[ -f $FB_PY ]] || return
    python3 "$FB_PY" \
        --fail-list "${1:-}" \
        --from-ver  "${2:-}" \
        --to-ver    "${3:-}" \
        2>/dev/null
}

# 启动背景计时器：每秒用最新状态 + 已用秒数重新绘制 fb
# 参数: $1 = 父进程 PID（父进程退出后定时器自动停止）
fb_timer_start() {
    local parent_pid=$1
    {
        local elapsed=0
        while kill -0 "$parent_pid" 2>/dev/null; do
            if [[ -f $FB_STATE_FILE ]]; then
                IFS='|' read -r prog status count total fv tv < "$FB_STATE_FILE"
                python3 "$FB_PY" \
                    --progress "${prog:-0}" \
                    --status   "${status:-}" \
                    --count    "${count:-0}" \
                    --total    "${total:-1}" \
                    --from-ver "${fv:-}" \
                    --to-ver   "${tv:-}" \
                    --elapsed  "$elapsed" \
                    2>/dev/null
            fi
            sleep 1
            elapsed=$(( elapsed + 1 ))
        done
    } &
    echo $! > "$FB_TIMER_PID"
}

fb_timer_stop() {
    [[ -f $FB_TIMER_PID ]] && kill "$(cat "$FB_TIMER_PID")" 2>/dev/null
    rm -f "$FB_TIMER_PID" "$FB_STATE_FILE"
}

fb_cleanup() {
    fb_timer_stop
    rm -f "$FB_PY"
}

